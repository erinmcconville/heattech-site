---
import { getEntry } from 'astro:content';

// One job from "Examples of our work". Renders nothing unless the job is published with permission.
interface Props { id: string }
const entry = await getEntry('work', Astro.props.id);
const live = entry && entry.data.published && entry.data.permission_recorded;
---
{live && entry && (
  <a class="work-card" href={`/work/${entry.id}/`}>
    <span class="photo-slot work-card__photo">{entry.data.photos[0]}</span>
    <span class="work-card__body">
      <span class="work-card__title">{entry.data.title}</span>
      {entry.data.summary && <span class="work-card__summary">{entry.data.summary}</span>}
      <span class="work-card__more">See the job <span aria-hidden="true">→</span></span>
    </span>
  </a>
)}

<style>
  .work-card {
    display: flex; flex-direction: column; overflow: hidden; max-width: 22rem;
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius);
    color: var(--ink); text-decoration: none;
  }
  .work-card:hover { border-color: var(--line-strong); }
  .work-card__photo { aspect-ratio: 4 / 3; border-radius: 0; font-size: var(--small); }
  .work-card__body { display: grid; gap: 0.25rem; padding: var(--s2); }
  .work-card__title { font-family: var(--font-brand); font-weight: 700; line-height: 1.3; }
  .work-card__summary { color: var(--muted); font-size: var(--small); }
  .work-card__more { margin-top: var(--s1); color: var(--copper-deep); font-family: var(--font-brand); font-weight: 600; font-size: var(--small); }
</style>
