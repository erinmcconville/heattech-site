---
import { getEntry } from 'astro:content';
import Icon from './Icon.astro';
import Text from './Text.astro';

// One job from "Examples of our work": photo, title, one detail and "See the job"; the rest is on the job page.
// Renders nothing unless the job is published with permission, or is a sample.
// feature: the full-width version, used while there are fewer than three jobs (rule 24).
interface Props { id: string; feature?: boolean }
const { id, feature = false } = Astro.props;
const entry = await getEntry('work', id);
const live = entry && ((entry.data.published && entry.data.permission_recorded) || entry.data.sample);
---
{live && entry && (
  <a class:list={['work-card', { 'work-card--feature': feature }]} href={`/work/${entry.id}/`}>
    <span class="photo-slot work-card__photo">{entry.data.photos[0]}</span>
    <span class="work-card__body">
      <span class="work-card__title"><Text value={entry.data.title} /></span>
      {entry.data.summary && <span class="work-card__summary">{entry.data.summary}</span>}
      <span class="work-card__more">See the job <Icon name="chevron-right" size={18} /></span>
    </span>
  </a>
)}

<style>
  .work-card {
    display: flex; flex-direction: column; overflow: hidden; max-width: 22rem;
    background: var(--surface); border-radius: var(--radius); box-shadow: var(--shadow);
    color: var(--ink); text-decoration: none;
  }
  .work-card:hover .work-card__more { text-decoration: underline; }
  .work-card__photo { aspect-ratio: 16 / 10; border-radius: 0; font-size: var(--small); }
  .work-card__body { display: flex; flex-direction: column; gap: 0.4rem; padding: var(--s3); flex: 1; }
  .work-card__summary { color: var(--muted); font-size: var(--small); }
  .work-card__title { font-family: var(--font-brand); font-weight: 700; font-size: 1.25rem; line-height: 1.2; letter-spacing: -0.01em; }
  .work-card__more { display: inline-flex; align-items: center; align-self: start; gap: 0.3rem; min-height: 2.75rem; margin-top: auto; color: var(--copper-deep); font-family: var(--font-brand); font-weight: 700; font-size: var(--small); }

  .work-card--feature { max-width: none; }
  .work-card--feature .work-card__body { justify-content: center; }
  .work-card--feature .work-card__more { margin-top: var(--s1); }
  @media (min-width: 60rem) {
    .work-card--feature { display: grid; grid-template-columns: 1.2fr 1fr; }
    .work-card--feature .work-card__photo { aspect-ratio: auto; min-height: 22rem; }
    .work-card--feature .work-card__body { padding: 2.5rem; }
    .work-card--feature .work-card__title { font-size: 1.75rem; }
  }
</style>
