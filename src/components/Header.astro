---
import Text from './Text.astro';

interface Props { site: Record<string, Record<string, any>> }
const { site } = Astro.props;
const { contact, availability } = site;

const nav = [
  { href: '/services/', label: 'Services' },
  { href: '/stories/', label: 'Stories' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];
const path = Astro.url.pathname;
---
<header class="site-header">
  <div class="wrap site-header__inner">
    <a href="/" class="logo" aria-label="Heattech Gas Services, home">
      <span class="logo__slot">[PLACEHOLDER: HeatTech logo with flame]</span>
    </a>

    <nav aria-label="Main">
      <ul class="nav">
        {nav.map((item) => (
          <li><a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="header-actions">
      <a class="header-call" href={`tel:${contact.phone_link}`}>Urgent: call {contact.phone}</a>
      <a class="button" href="/contact/">Send an enquiry</a>
    </div>
  </div>

  {availability.show && availability.notice && (
    <p class="availability"><span class="wrap"><Text value={availability.notice} /></span></p>
  )}
</header>

<style>
  .site-header { background: var(--surface); border-bottom: 1px solid var(--border); }
  .site-header__inner {
    display: flex; flex-wrap: wrap; align-items: center;
    gap: 0.75rem 1.5rem; padding-block: 0.75rem;
  }
  .logo { text-decoration: none; color: var(--text); }
  .logo__slot {
    display: inline-flex; align-items: center; min-height: 3rem; padding: 0.25rem 0.75rem;
    background: var(--photo); border-radius: var(--radius); font-size: var(--small);
  }
  .nav { display: flex; flex-wrap: wrap; gap: 0.25rem 1.25rem; list-style: none; margin: 0; padding: 0; }
  .nav a { display: inline-block; padding: 0.5rem 0; text-decoration: none; }
  .nav a:hover, .nav a[aria-current='page'] { text-decoration: underline; text-decoration-thickness: 2px; }
  .header-actions { display: none; }
  .availability { margin: 0; max-width: none; background: var(--bg); border-top: 1px solid var(--border); padding-block: 0.5rem; }
  .availability .wrap { display: block; }

  /* Phones use the bottom bar instead of these buttons */
  @media (min-width: 900px) {
    .header-actions { display: flex; align-items: center; gap: 1.25rem; margin-left: auto; }
    .header-call { font-size: var(--small); }
  }
</style>
