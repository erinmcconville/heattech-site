---
import Text from './Text.astro';
import { getServices } from '../lib/site';

interface Props { site: Record<string, Record<string, any>> }
const { site } = Astro.props;
const { business, contact, availability } = site;
const services = await getServices();

// The menu is a <details> element, so it opens without JavaScript
const nav = [
  ...services.map((s) => ({ href: `/${s.id}/`, label: s.data.title })),
  { href: '/work/', label: 'Examples of our work' },
  { href: '/reviews/', label: 'Reviews' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];
const path = Astro.url.pathname;
---
<header class="site-header">
  <div class="wrap site-header__inner">
    <a href="/" class="logo">
      <!-- [PLACEHOLDER: logo as PNG with transparent background, or SVG, from Ryan] -->
      <img src="/brand/logo-header.png" width="532" height="308" alt={`${business.trading_name} Ltd, home`} />
    </a>

    <a class="button button--on-dark call" href={`tel:${contact.phone_link}`}>Call</a>

    <details class="menu">
      <summary>Menu</summary>
      <nav aria-label="Main">
        <ul>
          {nav.map((item) => (
            <li><a href={item.href} aria-current={path === item.href ? 'page' : undefined}>{item.label}</a></li>
          ))}
        </ul>
      </nav>
    </details>
  </div>

  {availability.show && availability.notice && (
    <p class="availability"><span class="wrap"><Text value={availability.notice} /></span></p>
  )}
</header>

<style>
  .site-header { background: var(--charcoal); color: var(--on-dark); position: relative; }
  .site-header__inner { display: flex; align-items: center; gap: var(--s2); padding-block: 0.75rem; }
  .logo { display: block; flex: none; margin-right: auto; }
  .logo img { height: 3rem; width: auto; }
  .call { min-height: 2.5rem; padding-inline: 1rem; }

  .menu summary {
    display: inline-flex; align-items: center; min-height: var(--tap); padding: 0 0.25rem;
    cursor: pointer; list-style: none;
    font-family: var(--font-brand); font-weight: 600; font-size: var(--small);
  }
  .menu summary::-webkit-details-marker { display: none; }
  .menu summary::after { content: ''; width: 0.5rem; height: 0.5rem; margin-left: 0.5rem; border: solid currentColor; border-width: 0 2px 2px 0; transform: rotate(45deg) translateY(-2px); }
  .menu[open] summary::after { transform: rotate(-135deg) translateY(-2px); }
  .menu nav {
    position: absolute; left: 0; right: 0; top: 100%; z-index: 30;
    background: var(--charcoal); border-top: 1px solid rgba(255, 255, 255, 0.15);
  }
  .menu ul { list-style: none; margin: 0 auto; padding: var(--s1) var(--gutter) var(--s2); max-width: var(--page); }
  .menu a {
    display: flex; align-items: center; min-height: var(--tap);
    color: var(--on-dark); text-decoration: none; font-family: var(--font-brand); font-weight: 600;
  }
  .menu a[aria-current='page'] { color: var(--copper); }
  .menu a:focus-visible, .call:focus-visible, .menu summary:focus-visible { outline-color: var(--on-dark); }

  .availability {
    margin: 0; max-width: none; padding-block: var(--s1);
    background: var(--copper); color: var(--ink); font-weight: 600; font-size: var(--small);
  }
  .availability .wrap { display: block; }

  @media (min-width: 60rem) {
    .logo img { height: 3.5rem; }
    .call { order: 2; }
  }
</style>
