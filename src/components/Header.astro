---
import Text from './Text.astro';

interface Props { site: Record<string, Record<string, any>> }
const { site } = Astro.props;
const { contact, availability } = site;

const nav = [
  { href: '/services/', label: 'Services' },
  { href: '/work/', label: 'Recent work' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];
const path = Astro.url.pathname;
---
<header class="site-header">
  <div class="wrap site-header__inner">
    <a href="/" class="logo">
      <!-- [PLACEHOLDER: logo as PNG with transparent background, or SVG, from Ryan] -->
      <img src="/brand/logo-header.png" width="532" height="308" alt="HeatTech Gas Services Ltd, home" />
    </a>

    <nav aria-label="Main" class="nav">
      <ul>
        {nav.map((item) => (
          <li><a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="header-actions">
      <a class="button button--on-dark" href={`tel:${contact.phone_link}`}>Call {contact.phone}</a>
      <a class="button" href="/contact/">Send an enquiry</a>
    </div>
  </div>

  {availability.show && availability.notice && (
    <p class="availability"><span class="wrap"><Text value={availability.notice} /></span></p>
  )}
</header>

<style>
  .site-header { background: var(--charcoal); color: var(--on-dark); }
  .site-header__inner {
    display: flex; flex-wrap: wrap; align-items: center;
    gap: var(--s1) var(--s4); padding-block: 0.75rem var(--s1);
  }
  .logo { display: block; flex: none; }
  .logo img { height: 3.5rem; width: auto; }

  .nav { flex-basis: 100%; }
  .nav ul { display: flex; gap: var(--s3); list-style: none; margin: 0; padding: 0; max-width: none; }
  .nav li { white-space: nowrap; }
  @media (max-width: 26rem) { .nav ul { gap: var(--s2); } .nav a { font-size: 0.9375rem; } }
  .nav a {
    display: inline-flex; align-items: center; min-height: var(--tap);
    color: var(--on-dark); text-decoration: none;
    font-family: var(--font-brand); font-weight: 600; font-size: var(--small);
    border-bottom: 3px solid transparent;
  }
  .nav a:hover { border-bottom-color: var(--on-dark-muted); }
  .nav a[aria-current='page'] { border-bottom-color: var(--copper); }
  .nav a:focus-visible, .header-actions a:focus-visible { outline-color: var(--on-dark); }

  .header-actions { display: none; }

  .availability {
    margin: 0; max-width: none; padding-block: var(--s1);
    background: var(--copper); color: var(--ink); font-weight: 600; font-size: var(--small);
  }
  .availability .wrap { display: block; }

  /* Wider screens: one row, with the actions on the right. Phones use the bottom bar instead. */
  @media (min-width: 60rem) {
    .site-header__inner { flex-wrap: nowrap; padding-block: var(--s2); }
    .logo img { height: 4rem; }
    .nav { flex-basis: auto; }
    .header-actions { display: flex; align-items: center; gap: 0.75rem; margin-left: auto; }
  }
</style>
