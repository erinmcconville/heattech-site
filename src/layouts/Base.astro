---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import { getSite } from '../lib/site';

// emergencyBand: false on pages that already carry their own gas emergency line, so it isn't shown twice
// headerOver: the header sits transparent over the page's hero (the homepage footage)
// bare: the page lays out its own full-width sections instead of one centred column
interface Props { title: string; description?: string; noindex?: boolean; jsonLd?: object; emergencyBand?: boolean; headerOver?: boolean; bare?: boolean }
const { title, description, noindex, jsonLd, emergencyBand = true, headerOver = false, bare = false } = Astro.props;
const site = await getSite();
const { business, contact, links } = site;
const canonical = new URL(Astro.url.pathname, Astro.site);

// The business record for search and answer engines, on every page.
// No review stars, opening hours or Gas Safe credential until confirmed (decisions.md, CLAUDE.md guardrails).
const businessLd = {
  '@context': 'https://schema.org',
  '@type': ['Plumber', 'HVACBusiness'],
  '@id': new URL('/#business', Astro.site).href,
  name: business.trading_name,
  legalName: business.legal_name,
  description: business.description,
  url: new URL('/', Astro.site).href,
  logo: new URL('/brand/logo-header.png', Astro.site).href,
  image: new URL('/brand/logo-header.png', Astro.site).href,
  telephone: contact.phone_link,
  email: contact.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: contact.address_line_1,
    addressLocality: contact.town,
    postalCode: contact.postcode,
    addressCountry: 'GB',
  },
  areaServed: [
    { '@type': 'City', name: 'Edinburgh' },
    { '@type': 'AdministrativeArea', name: 'Lothian' },
  ],
  sameAs: [links.google_reviews, links.facebook, links.mybuilder],
};
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="preload" href="/fonts/montserrat-latin-variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/source-sans-3-latin-variable.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#2a2a2c" />
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonical.href} />}
    <link rel="sitemap" href="/sitemap.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(businessLd)} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header site={site} over={headerOver} />
    <main id="main">
      <slot name="hero" />
      {bare ? <slot /> : <div class="wrap page"><slot /></div>}
    </main>
    <Footer site={site} emergencyBand={emergencyBand} />
    <MobileBar site={site} />
  </body>
</html>

<style is:global>
  /* Room for the fixed bottom bar on phones */
  @media (max-width: 59.99rem) { .site-footer { padding-bottom: var(--bar-height); } }
</style>
