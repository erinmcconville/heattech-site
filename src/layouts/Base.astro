---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import { getSite } from '../lib/site';

interface Props { title: string; description?: string; noindex?: boolean }
const { title, description, noindex } = Astro.props;
const site = await getSite();
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="preload" href="/fonts/montserrat-latin-variable.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#4f4f51" />
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header site={site} />
    <main id="main" class="wrap">
      <slot />
    </main>
    <Footer site={site} />
    <MobileBar site={site} />
  </body>
</html>

<style is:global>
  /* Room for the fixed bottom bar on phones */
  @media (max-width: 59.99rem) { body { padding-bottom: var(--bar-height); } }
</style>
