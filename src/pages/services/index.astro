---
import { getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Text from '../../components/Text.astro';
import ReviewCard from '../../components/ReviewCard.astro';
import { getSite, getServices } from '../../lib/site';

const site = await getSite();
const { promises, call_out_fee, safety } = site;
const services = await getServices();
---
<Base
  title="Boiler repairs, servicing and gas safety in Edinburgh | Services | Heattech Gas Services"
  description="Heating, boiler and plumbing jobs in Edinburgh and the Lothians, from repairs and new boilers to landlord gas safety certificates."
>
  <span class="eyebrow">Services</span>
  <h1>Heating, gas and plumbing jobs</h1>
  <p class="lede">{promises.written_quote}</p>
  {call_out_fee.show && call_out_fee.text && <p><Text value={call_out_fee.text} /></p>}

  <nav aria-label="On this page" class="jump-bar">
    <ul class="jump">
      {services.map((s) => <li><a href={`#${s.id}`}>{s.data.title}</a></li>)}
    </ul>
  </nav>

  {services.map(async (s) => {
    const ex = s.data.explainer;
    const exStory = ex ? await getEntry('stories', ex.story) : undefined;
    const exStoryLive = exStory && exStory.data.published && exStory.data.permission_recorded;
    const proof = s.data.review ? await getEntry('reviews', s.data.review) : undefined;
    return (
      <section class="section" id={s.id} aria-labelledby={`${s.id}-title`}>
        <h2 id={`${s.id}-title`}>{s.data.title}</h2>
        <ul class="plain-list jobs">
          {s.data.jobs.map((j) => (
            <li id={j.id}>
              <span class="job">{j.label}</span>
              {j.emergency ? (
                <p class="emergency-note">
                  Call the Gas Emergency number, <a href={`tel:${safety.gas_emergency_link}`}>{safety.gas_emergency_number}</a>, first.
                  {' '}<Text value={j.note?.replace(/^Call the Gas Emergency number, [0-9 ]+, first\.\s*/, '')} />
                </p>
              ) : (
                j.note && <p class="small"><Text value={j.note} /></p>
              )}
              {!j.emergency && <a class="ask" href={`/contact/?job=${j.id}`}>Ask about this<span class="visually-hidden">: {j.label}</span> <span aria-hidden="true">→</span></a>}
            </li>
          ))}
        </ul>

        {proof && proof.data.complete && <div class="proof"><ReviewCard review={proof.data} /></div>}

        {ex && (
          <details class="explainer card">
            <summary>{ex.title}</summary>
            <p>{ex.intro}</p>
            <ul>
              {ex.points.map((p) => (
                <li><strong>{p.label}.</strong> {p.text} <a href={p.link}>{p.link_text}</a></li>
              ))}
            </ul>
            {exStoryLive && <p>A real example: <a href={`/stories/${exStory.id}/`}>{exStory.data.title}</a>.</p>}
          </details>
        )}
      </section>
    );
  })}

  <p class="section small"><Text value="[CONFIRM WITH RYAN: small commercial premises]" /></p>
</Base>

<style>
  /* Section links stay pinned at the top while scrolling */
  .jump-bar {
    position: sticky; top: 0; z-index: 10;
    margin: var(--s3) calc(-1 * var(--gutter)) 0; padding: var(--s1) var(--gutter);
    background: var(--bg); border-bottom: 1px solid var(--line);
  }
  .jump { display: flex; gap: var(--s1); padding: 0; margin: 0; list-style: none; max-width: none; overflow-x: auto; scrollbar-width: none; }
  .jump a {
    display: inline-flex; align-items: center; min-height: 2.5rem; padding: 0 0.9rem; white-space: nowrap;
    border: 1px solid var(--line-strong); border-radius: 999px; background: var(--surface);
    color: var(--ink); text-decoration: none; font-family: var(--font-brand); font-weight: 600; font-size: var(--label);
  }
  .jump a:hover { border-color: var(--charcoal); }

  .section { margin-top: var(--s5); }
  .jobs { max-width: 46rem; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); }
  .jobs li {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between;
    gap: var(--s1) var(--s2); min-height: 3.5rem; padding: 0.75rem var(--s2);
  }
  .jobs li:last-child { border-bottom: 0; }
  .jobs li p { flex-basis: 100%; margin: 0; order: 3; }
  .job { flex: 1 1 16rem; font-weight: 500; }
  .ask {
    display: inline-flex; align-items: center; min-height: var(--tap); white-space: nowrap;
    font-family: var(--font-brand); font-weight: 600; font-size: var(--label); text-decoration: none;
  }
  .ask:hover { text-decoration: underline; }

  .proof { margin-top: var(--s2); max-width: 46rem; }
  .explainer { margin-top: var(--s3); max-width: 46rem; padding: 0; }
  .explainer summary {
    display: flex; align-items: center; justify-content: space-between; gap: var(--s2);
    min-height: var(--tap); padding: var(--s2) 1.25rem; cursor: pointer; list-style: none;
    font-family: var(--font-brand); font-weight: 700;
  }
  .explainer summary::-webkit-details-marker { display: none; }
  .explainer summary::after { content: '+'; font-size: 1.5rem; line-height: 1; color: var(--copper-deep); }
  .explainer[open] summary::after { content: '−'; }
  .explainer > :not(summary) { margin-inline: 1.25rem; }
  .explainer > :last-child { margin-bottom: var(--s2); }
</style>
