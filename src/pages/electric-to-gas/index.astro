---
import Base from '../../layouts/Base.astro';
import WorkedExample from '../../components/WorkedExample.astro';
import { getSite } from '../../lib/site';

const { business } = await getSite();
const name = 'Electric heating to gas central heating';

const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name,
  serviceType: 'Electric or storage heaters to gas central heating',
  url: new URL('/electric-to-gas/', Astro.site).href,
  provider: { '@id': new URL('/#business', Astro.site).href },
  areaServed: business.area_served,
};
---
<Base
  title={`${name} in Edinburgh | ${business.trading_name}`}
  description="Converting an Edinburgh flat from electric or storage heaters to gas central heating: what decides whether it can be done, and a worked example in a Stockbridge period flat."
  jsonLd={serviceLd}
>
  <h1>{name}</h1>
  <p class="lede">For flats with electric or storage heaters.</p>

  <section class="section" aria-labelledby="decides">
    <h2 id="decides">What decides whether it can be done</h2>
    <ul class="decides">
      <li>
        <strong>Gas supply.</strong> The building needs one. SGN checks for free:{' '}
        <a href="https://www.sgn.co.uk/gas-connections/household-customers/find-out-if-you-have-gas-supply">SGN gas supply check</a>.
        Flats on the second floor or above can need a separate connection quote from SGN:{' '}
        <a href="https://www.sgn.co.uk/gas-connections/household-customers/apply-new-gas-connection0">SGN new connections</a>.
      </li>
      <li>
        <strong>The flue.</strong> Where it can leave the building. On listed buildings and in conservation areas, the Council's guidance applies:{' '}
        <a href="https://www.edinburgh.gov.uk/conservation-2/listed-buildings">City of Edinburgh Council on listed buildings</a>.
      </li>
      <li><strong>Pipe routes.</strong> Through the roof space or under the floors.</li>
      <li><strong>Where the boiler goes.</strong> A cupboard, the hall or the kitchen.</li>
      <li>
        <strong>Funding.</strong> Home Energy Scotland's standard grant and loan doesn't cover gas boilers:{' '}
        <a href="https://www.homeenergyscotland.org/find-funding">Home Energy Scotland funding</a>.
        Warmer Homes Scotland can help some households with central heating:{' '}
        <a href="https://www.mygov.scot/energy-saving-funding/warmer-homes-scotland-scheme">Warmer Homes Scotland</a>.
      </li>
    </ul>
    <p class="small checked">Last checked 27 October 2026</p>
  </section>

  <WorkedExample id="stockbridge-gas-central-heating" />

  <p class="section"><a class="button" href="/contact/?job=electric-to-gas">Ask about this</a></p>
</Base>

<style>
  .decides { max-width: 46rem; display: grid; gap: var(--s2); }
  .checked { color: var(--muted); }
</style>
