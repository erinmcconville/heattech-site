---
import Base from '../../layouts/Base.astro';
import Text from '../../components/Text.astro';
import { getSite } from '../../lib/site';

const site = await getSite();
const { business, credentials, links } = site;

// One factual sentence that search and answer engines can quote (decisions.md)
const entity = `${business.legal_name} is a Gas Safe registered gas, heating and plumbing company based in ${business.based_in}, covering ${business.area_served}.`;
---
<Base title={`About | ${business.legal_name}, Edinburgh`} description={entity}>
  <h1>About us</h1>
  <p class="lede">{entity}</p>

  <div class="photo-slot team-photo">[PHOTO: Ryan and Brett with the van]</div>

  <dl class="people">
    <div>
      <dt>{business.engineer}</dt>
      <dd><Text value="[PLACEHOLDER: one or two lines about Ryan, in his words]" /></dd>
    </div>
    <div>
      <dt>{business.colleague_name}</dt>
      <dd><Text value={business.colleague_role} /></dd>
    </div>
  </dl>

  <table class="facts">
    <tbody>
      <tr>
        <th scope="row">Gas Safe</th>
        <td><Text value={credentials.gas_safe_number} /> · <a href={credentials.gas_safe_register_url}>Check it on the register</a></td>
      </tr>
      <tr><th scope="row">Company number</th><td>{business.company_number}</td></tr>
      <tr><th scope="row">Insurance</th><td><Text value={credentials.insurance} /></td></tr>
      <tr><th scope="row">Based in</th><td>{business.based_in}</td></tr>
    </tbody>
  </table>

  <section class="section" aria-labelledby="football">
    <h2 id="football">Local football</h2>
    <p>{business.football.line}</p>
    <div class="football-photos">
      {business.football.photos.map((p: string) => <div class="photo-slot">{p}</div>)}
    </div>
  </section>

  <p class="section links">
    <a href={links.google_reviews}>Google</a>{' · '}
    <a href={links.facebook}>Facebook</a>{' · '}
    <a href={links.mybuilder}>MyBuilder</a>
  </p>
</Base>

<style>
  .team-photo { margin-top: var(--s3); max-width: 46rem; aspect-ratio: 4 / 3; }
  .people { display: grid; gap: var(--s2); margin: var(--s4) 0 0; max-width: 46rem; }
  .people dt { font-family: var(--font-brand); font-weight: 700; }
  .people dd { margin: 0; color: var(--muted); }
  .facts { margin-top: var(--s4); width: 100%; max-width: 32rem; border-collapse: collapse; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); }
  .facts th, .facts td { padding: 0.75rem var(--s2); text-align: left; vertical-align: top; }
  .facts tr + tr th, .facts tr + tr td { border-top: 1px solid var(--line); }
  .facts th { font-weight: 400; color: var(--muted); width: 40%; }
  .facts td { font-weight: 600; }
  .section { margin-top: var(--s5); max-width: 46rem; }
  .football-photos { display: grid; gap: var(--s1); grid-template-columns: 1fr 1fr; }
  .football-photos .photo-slot { aspect-ratio: 1; font-size: var(--small); }
  .links { font-family: var(--font-brand); font-weight: 600; }
</style>
