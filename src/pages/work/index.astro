---
import Base from '../../layouts/Base.astro';
import WorkCard from '../../components/WorkCard.astro';
import { getPublishedWork } from '../../lib/site';

const work = await getPublishedWork();
---
<Base
  title="Recent work in Edinburgh | Heattech Gas Services"
  description="Recent gas, heating and plumbing jobs in Edinburgh flats and homes: what the job was and what was done."
>
  <h1>Recent work</h1>
  <div class="grid">
    {work.map((w) => <WorkCard entry={w} />)}
  </div>
</Base>
