---
// One page per job: title, tags, photos, Before / The challenge / What we did, one quote.
// Only published jobs with permission recorded get a page.
import Base from '../../layouts/Base.astro';
import Text from '../../components/Text.astro';
import { getEntry } from 'astro:content';
import { getSite, getLiveWork } from '../../lib/site';

export async function getStaticPaths() {
  const work = await getLiveWork();
  return work.map((w) => ({ params: { slug: w.id }, props: { job: w } }));
}

const { job } = Astro.props;
const d = job.data;
const { business } = await getSite();
const service = d.service ? await getEntry('services', d.service) : undefined;
const quote = d.quotes[0];
const [mainPhoto, ...otherPhotos] = d.photos;
---
<Base title={`${d.title} | ${business.trading_name}`} description={d.summary ?? d.title}>
  <p class="back"><a href="/work/">Examples of our work</a></p>
  <h1>{d.title}</h1>
  {d.tags.length > 0 && <ul class="tags">{d.tags.map((t) => <li>{t}</li>)}</ul>}

  <div class="photos">
    {mainPhoto && <div class="photo-slot photos__main">{mainPhoto}</div>}
    {otherPhotos.slice(0, 2).map((p) => <div class="photo-slot">{p}</div>)}
  </div>

  {d.bills && (
    <section class="bills" aria-labelledby="bills-title">
      <h2 id="bills-title">Energy bills</h2>
      <div class="bills__pair">
        <div><span class="bills__label">Before</span><span class="bills__value"><Text value={d.bills.before} /></span><span class="bills__unit">a month</span></div>
        <div><span class="bills__label">After</span><span class="bills__value"><Text value={d.bills.after} /></span><span class="bills__unit">a month</span></div>
      </div>
      <p class="small">{d.bills.note}</p>
    </section>
  )}

  <dl class="story">
    <dt>Before</dt><dd>{d.problem}</dd>
    {d.challenge && <><dt>The challenge</dt><dd>{d.challenge}</dd></>}
    <dt>What we did</dt><dd><Text value={d.what_ryan_did} /></dd>
  </dl>
  {d.gas_supply_already_there && <p class="small"><Text value={d.gas_supply_already_there} /></p>}
  {d.ryan_check && <p class="small"><Text value={d.ryan_check} /></p>}

  {quote && (
    <figure class="quote job-quote">
      <blockquote>{quote.text}</blockquote>
      <figcaption>{quote.who}</figcaption>
    </figure>
  )}

  <div class="section next">
    {service && <p>More about <a href={`/${service.id}/`}>{service.data.title.toLowerCase()}</a></p>}
    <a class="button" href={`/contact/?job=${d.service ?? 'not-sure'}`}>Ask about a job like this</a>
  </div>
</Base>

<style>
  .back { margin: -0.75rem 0 0; font-size: var(--small); }
  .back a { display: inline-flex; align-items: center; min-height: 2.75rem; color: var(--muted); }
  h1 { margin-top: 0; max-width: 24ch; }
  .tags { list-style: none; padding: 0; margin: var(--s1) 0 0; color: var(--muted); font-size: var(--small); }
  .tags li { display: inline; }
  /* The no-break space keeps each dot on the line before it when the tags wrap */
  .tags li + li::before { content: '\00a0\00b7  '; }
  .photos { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s1); margin-top: var(--s3); max-width: 46rem; }
  .photos .photo-slot { aspect-ratio: 1; }
  .photos__main { grid-column: 1 / -1; aspect-ratio: 4 / 3 !important; }
  .bills { margin-top: var(--s4); max-width: 46rem; padding: var(--s3); background: var(--surface); border-radius: var(--radius); box-shadow: var(--shadow); }
  .bills h2 { margin: 0 0 var(--s2); font-size: var(--step-1); }
  .bills__pair { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s2); }
  .bills__pair > div { display: grid; align-content: start; }
  .bills__pair > div + div { padding-left: var(--s2); border-left: 1px solid var(--line); }
  .bills__label { font-family: var(--font-brand); font-weight: 600; font-size: var(--small); color: var(--muted); }
  .bills__value { font-family: var(--font-brand); font-weight: 700; font-size: var(--step-2); line-height: 1.15; overflow-wrap: anywhere; }
  .bills__unit { color: var(--muted); font-size: var(--small); }
  .bills .small { margin: var(--s2) 0 0; color: var(--muted); }
  .story { max-width: 46rem; margin: var(--s4) 0 0; display: grid; gap: 0.25rem; }
  .story dt { margin-top: var(--s2); font-family: var(--font-brand); font-weight: 600; font-size: var(--small); color: var(--copper-deep); }
  .story dd { margin: 0; }
  .job-quote { margin-top: var(--s4); max-width: 46rem; }
  .next { margin-top: var(--s5); }
</style>
