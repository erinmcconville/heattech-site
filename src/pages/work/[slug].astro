---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Text from '../../components/Text.astro';
import { getPublishedWork } from '../../lib/site';

// Only published work with permission recorded gets a page.
export async function getStaticPaths() {
  const work = await getPublishedWork();
  return work.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);

const fields = [
  { heading: 'The problem', value: d.problem },
  { heading: 'What was usually suggested', value: d.usual_approach },
  { heading: 'What Ryan did', value: d.what_ryan_did },
  { heading: 'The result', value: d.result },
].filter((f) => f.value);

// Structured data so search and answer engines can cite the job
const article = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.title,
  about: d.job_type,
  contentLocation: { '@type': 'Place', name: `${d.area}, Edinburgh` },
  author: { '@id': new URL('/#business', Astro.site).href },
  publisher: { '@id': new URL('/#business', Astro.site).href },
};
---
<Base title={`${d.title} | Heattech Gas Services`} description={d.summary ?? `${d.area}, ${d.property.toLowerCase()}. ${d.what_ryan_did}`} jsonLd={article}>
  <p class="small"><a href="/work/">Recent work</a></p>
  <h1><Text value={d.title} /></h1>
  <p class="small">{d.area} · {d.property}</p>
  {d.ryan_check && <p class="small"><Text value={d.ryan_check} /></p>}

  {fields.map((f) => (
    <>
      <h2>{f.heading}</h2>
      <p><Text value={f.value} /></p>
    </>
  ))}

  <div class="content"><Content /></div>

  {d.quotes.length > 0 && (
    <>
      <h2>In the customer's words</h2>
      <div class="stack">
        {d.quotes.map((q) => (
          <figure class="quote">
            <blockquote><Text value={`"${q.text}"`} /></blockquote>
            <figcaption><Text value={q.who} /></figcaption>
          </figure>
        ))}
      </div>
    </>
  )}

  <h2>Photos</h2>
  <div class="grid photos">
    {d.photos.map((p) => <div class="photo-slot">{p}</div>)}
  </div>

  <div class="section actions">
    <a class="button" href={`/contact/?job=${d.job_type}`}>Ask about a job like this</a>
  </div>
</Base>

<style>
  .quote { margin: 0; padding: 1rem 1.25rem; background: var(--surface); border-left: 4px solid var(--copper); max-width: var(--measure); }
  .quote blockquote { margin: 0 0 0.5rem; }
  .quote figcaption { font-size: var(--small); color: var(--muted); }
  .photos { max-width: 48rem; }
</style>
