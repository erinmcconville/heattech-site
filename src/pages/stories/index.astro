---
import Base from '../../layouts/Base.astro';
import StoryCard from '../../components/StoryCard.astro';
import { getPublishedStories } from '../../lib/site';

const stories = await getPublishedStories();
---
<Base
  title="Real jobs in Edinburgh | Stories | Heattech Gas Services"
  description="Real heating and gas jobs in Edinburgh flats and homes: the problem, what was done and the result."
>
  <h1>Real stories</h1>
  <p class="lede">Real jobs, each told the same way: the problem, what was usually suggested, what was done and the result.</p>
  <div class="stack">
    {stories.map((s) => <StoryCard story={s} />)}
  </div>
</Base>
