---
import { getCollection, getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Text from '../components/Text.astro';
import ReviewCard from '../components/ReviewCard.astro';
import StoryCard from '../components/StoryCard.astro';
import { getSite } from '../lib/site';

const site = await getSite();
const { business, contact, credentials, links, promises } = site;
const services = await getCollection('services');
const reviews = await getCollection('reviews');
const featured = reviews.filter((r) => r.data.featured).slice(0, 8);
const stockbridge = await getEntry('stories', 'stockbridge-gas-central-heating');
const stockbridgeLive = stockbridge && stockbridge.data.published && stockbridge.data.permission_recorded;

const reviewFor = (promise: string) => reviews.find((r) => r.data.proves === promise)?.data;

// "How we work": each line sits next to its proof (a review or a job detail).
const howWeWork = [
  {
    title: 'Replying and turning up',
    text: promises.after_enquiry,
    review: reviewFor('reply-and-turn-up'),
    need: 'a quick reply and turning up when arranged',
  },
  {
    title: 'Repair or replace',
    text: "One customer's boiler had a few years left in it. It got a small repair instead of a replacement, and it is still working.",
    proofNote: '[CONFIRM WITH RYAN: happy for this job to be described here]',
    review: reviewFor('repair-first'),
    need: 'a repair instead of a new boiler',
  },
  {
    title: 'Tidy work',
    text: 'The Stockbridge conversion took about three days, with no floors lifted.',
    quote: { text: "He doesn't leave a mess.", who: 'Erin, Stockbridge flat owner' },
    review: reviewFor('tidy'),
    need: 'tidy work',
  },
  {
    title: 'Aftercare',
    text: promises.aftercare,
    review: reviewFor('comes-back'),
    need: 'coming back to put something right',
  },
];
---
<Base
  title="Boiler repairs, servicing and gas safety in Edinburgh | Heattech Gas Services"
  description={`${business.description} Based in ${business.based_in}.`}
>
  <section class="hero">
    <h1>{business.description}</h1>
    <p class="lede">Heattech Gas Services, based in {business.based_in}. Run by {business.engineer}.</p>
    <div class="actions">
      <a class="button" href="/contact/">Send an enquiry</a>
      <a class="button button--plain" href={`tel:${contact.phone_link}`}>Urgent: call {contact.phone}</a>
    </div>
    <p class="small">
      <a href={links.google_reviews}>Read our reviews on Google</a>{' · '}
      <a href={credentials.gas_safe_register_url}>Gas Safe</a> <Text value={credentials.gas_safe_number} /> (check it on the register)
    </p>
    <p class="small">{promises.written_quote}</p>
  </section>

  <section class="section" aria-labelledby="what-we-do">
    <h2 id="what-we-do">What we do</h2>
    <div class="grid">
      {services.map((s) => (
        <div>
          <h3><a href={`/services/#${s.id}`}>{s.data.title}</a></h3>
          <ul>
            {s.data.jobs.filter((j) => j.home).slice(0, 4).map((j) => <li>{j.label}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section class="section" aria-labelledby="how-we-work">
    <h2 id="how-we-work">How we work</h2>
    <div class="grid">
      {howWeWork.map((item) => (
        <div class="stack">
          <h3>{item.title}</h3>
          <p><Text value={item.text} /></p>
          {item.proofNote && <p class="small"><Text value={item.proofNote} /></p>}
          {item.quote && (
            <figure class="quote">
              <blockquote>"{item.quote.text}"</blockquote>
              <figcaption>{item.quote.who}</figcaption>
            </figure>
          )}
          {!item.quote && <ReviewCard review={item.review} need={item.need} />}
        </div>
      ))}
    </div>
  </section>

  {stockbridgeLive && (
    <section class="section" aria-labelledby="a-recent-job">
      <h2 id="a-recent-job">A recent job</h2>
      <StoryCard story={stockbridge} />
    </section>
  )}

  <section class="section" aria-labelledby="reviews">
    <h2 id="reviews">Reviews</h2>
    <div class="grid">
      {featured.map((r) => <ReviewCard review={r.data} />)}
    </div>
    <p><a href={links.google_reviews}>All reviews on Google</a></p>
  </section>

  <section class="section" aria-labelledby="where-we-work">
    <h2 id="where-we-work">Where we work</h2>
    <p>{business.area_served}. Based in {business.based_in}.</p>
    <p>Recent jobs include a gas central heating conversion in <a href="/stories/stockbridge-gas-central-heating/">Stockbridge</a>. <Text value="[PLACEHOLDER: other neighbourhoods with real jobs to point to]" /></p>
  </section>

  <section class="section enquire" aria-labelledby="enquire">
    <h2 id="enquire">Send an enquiry</h2>
    <p>Tell us what the job is and where. Photos help.</p>
    <p><Text value={promises.after_enquiry} /></p>
    <div class="actions">
      <a class="button" href="/contact/">Send an enquiry</a>
      <a class="button button--plain" href={`tel:${contact.phone_link}`}>Call {contact.phone}</a>
    </div>
  </section>
</Base>

<style>
  .hero { padding-block: 1rem 0.5rem; }
  .quote { margin: 0; padding: 1rem 1.25rem; background: var(--surface); border-left: 4px solid var(--border); }
  .quote blockquote { margin: 0 0 0.5rem; }
  .quote figcaption { font-size: var(--small); color: var(--muted); }
  .enquire { padding: 1.5rem; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); }
</style>
