---
import Base from '../layouts/Base.astro';
import Text from '../components/Text.astro';
import ReviewCard from '../components/ReviewCard.astro';
import WorkCard from '../components/WorkCard.astro';
import { getSite, getServices, getReviews, getPublishedWork } from '../lib/site';

const site = await getSite();
const { business, contact, credentials, links } = site;
const services = await getServices();
const reviews = await getReviews();
const firstSix = reviews.slice(0, 6);
const theRest = reviews.slice(6);
const work = await getPublishedWork();
---
<Base
  title="Heattech Gas Services | Boilers, heating and plumbing in Edinburgh"
  description={`Gas Safe registered gas, heating and plumbing in Edinburgh and the Lothians, based in ${business.based_in}. Boiler repairs, new boilers, servicing and landlord gas safety certificates.`}
>
  <section class="hero" aria-labelledby="hero-title">
    <h1 id="hero-title">Gas, heating and plumbing in Edinburgh and the Lothians</h1>
    <div class="actions" data-hero-actions>
      <a class="button" href="/contact/">Send an enquiry</a>
      <a class="button button--plain" href={`tel:${contact.phone_link}`}>Call {contact.phone}</a>
    </div>
    <p class="quiet">
      <a href={credentials.gas_safe_register_url}>Gas Safe registered</a> <Text value={credentials.gas_safe_number} />
      {' · '}
      <a href={links.google_reviews}>{links.google_review_count} reviews on Google</a>
    </p>
  </section>

  <section class="section" aria-labelledby="jobs">
    <h2 id="jobs">Jobs we do</h2>
    <ul class="tiles">
      {services.map((s) => (
        <li class="tile card">
          <a href={`/services/#${s.id}`}>{s.data.tile}</a>
          <span>{s.data.keywords}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="section" aria-labelledby="reviews">
    <h2 id="reviews"><a href={links.google_reviews}>{links.google_review_count} reviews on Google</a></h2>
    <div class="reviews">
      {firstSix.map((r) => <ReviewCard review={r.data} />)}
    </div>
    {theRest.length > 0 && (
      <details class="more-reviews">
        <summary>Show more reviews</summary>
        <div class="reviews">
          {theRest.map((r) => <ReviewCard review={r.data} />)}
        </div>
      </details>
    )}
  </section>

  {work.length > 0 && (
    <section class="section" aria-labelledby="recent-work">
      <h2 id="recent-work">Recent work</h2>
      <div class="grid">
        {work.map((w) => <WorkCard entry={w} />)}
      </div>
    </section>
  )}

  <section class="section close" aria-labelledby="close">
    <h2 id="close">Tell us what's happening. Photos help.</h2>
    <a class="button" href="/contact/">Send an enquiry</a>
  </section>
</Base>

<style>
  .hero { padding-block: var(--s3) 0; }
  .hero h1 { max-width: 20ch; }
  .hero .actions { margin-top: var(--s3); }
  .quiet { font-size: var(--small); color: var(--muted); margin: 0; }
  .quiet a { color: var(--muted); }

  .tiles { display: grid; gap: var(--s2); grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr)); list-style: none; padding: 0; margin: 0; max-width: none; }
  /* Each tile is one tap target */
  .tile { position: relative; display: flex; flex-direction: column; gap: 0.25rem; padding: var(--s3); }
  .tile:hover { border-color: var(--line-strong); }
  .tile a { color: var(--ink); text-decoration: none; font-family: var(--font-brand); font-weight: 700; font-size: var(--step-1); line-height: 1.25; }
  .tile a::after { content: ''; position: absolute; inset: 0; }
  .tile:hover a { text-decoration: underline; }
  .tile span { color: var(--muted); font-size: var(--small); }

  #reviews a { color: var(--ink); text-decoration: none; }
  #reviews a:hover { text-decoration: underline; }
  /* Masonry-style columns so short and long reviews sit together without gaps */
  .reviews { columns: 18rem; column-gap: var(--s2); }
  .reviews > :global(*) { break-inside: avoid; margin-bottom: var(--s2); }
  .more-reviews summary {
    display: inline-flex; align-items: center; min-height: var(--tap); cursor: pointer; list-style: none;
    font-family: var(--font-brand); font-weight: 700; font-size: var(--small); color: var(--copper-deep);
  }
  .more-reviews summary::-webkit-details-marker { display: none; }
  .more-reviews[open] summary { display: none; }

  .close { padding: var(--s4) var(--s3); background: var(--charcoal); color: var(--on-dark); border-radius: var(--radius); }
  .close h2 { margin-bottom: var(--s3); }
  .close .button:focus-visible { outline-color: var(--on-dark); }
</style>
