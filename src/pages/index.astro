---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ReviewCard from '../components/ReviewCard.astro';
import { getSite, getServices, getReviews } from '../lib/site';

const site = await getSite();
const { business, contact, credentials, links } = site;
const services = await getServices();
const reviews = (await getReviews()).slice(0, 6);
---
<Base
  title={`${business.trading_name} | Boilers, heating and plumbing in Edinburgh`}
  description={`Gas Safe registered gas, heating and plumbing in Edinburgh and the Lothians, based in ${business.based_in}. Boiler repairs, new boilers, servicing and gas safety checks.`}
>
  <section slot="hero" class="hero" aria-labelledby="hero-title">
    <div class="wrap hero__inner">
      <div class="hero__text">
        <h1 id="hero-title">Gas, heating and plumbing across Edinburgh</h1>
        <p class="hero__line">Boiler repairs, new boilers, servicing and gas safety checks. Based in {business.based_in}.</p>
        <div class="actions" data-hero-actions>
          <a class="button" href="/contact/">Send an enquiry</a>
          <a class="button button--on-dark" href={`tel:${contact.phone_link}`}>Call {contact.phone}</a>
        </div>
      </div>
      <!-- [PLACEHOLDER: real photo from Ryan or Erin. Alt text names the job and place, never a house number.] -->
      <div class="hero__photo photo-slot"><span><Icon name="photo" size={28} />Photo needed: Ryan's van, or a finished boiler install</span></div>
    </div>
  </section>

  <ul slot="hero" class="strip" aria-label="Credentials">
    <li>
      <a href={links.google_reviews}>
        <img class="badge" src="/brand/google-g.png" width="192" height="192" alt="" />
        <span><strong>{links.google_rating}</strong> from {links.google_review_count} reviews on Google</span>
      </a>
    </li>
    <li>
      <a href={credentials.gas_safe_register_url}>
        <img class="badge" src="/brand/gas-safe.png" width="106" height="120" alt="Gas Safe Register" />
        <span>Gas Safe registered</span>
      </a>
    </li>
    <li>
      <Icon name="map-pin" size={20} />
      <span>{business.area_served}</span>
    </li>
  </ul>

  <section class="section" aria-labelledby="help">
    <h2 id="help">How we can help</h2>
    <ul class="tiles">
      {services.map((s) => (
        <li class="tile card">
          <span class="tile__icon"><Icon name={s.data.icon} size={26} /></span>
          <span>
            <a href={`/services/#${s.id}`}>{s.data.tile}</a>
            <span class="tile__keywords">{s.data.keywords}</span>
          </span>
        </li>
      ))}
    </ul>
  </section>

  <section class="section" aria-labelledby="reviews">
    <div class="section-head">
      <h2 id="reviews">What customers say</h2>
      <a href="/reviews/">Read all reviews <Icon name="arrow-right" size={18} /></a>
    </div>
    <div class="reviews">
      {reviews.map((r) => <ReviewCard review={r.data} short />)}
    </div>
  </section>

  <section class="section contact-band" aria-labelledby="get-in-touch">
    <div>
      <h2 id="get-in-touch">Get in touch</h2>
      <p>
        <a href={`tel:${contact.phone_link}`}>{contact.phone}</a>{' · '}
        <a href={`mailto:${contact.email}`}>{contact.email}</a>
      </p>
    </div>
    <a class="button" href="/contact/">Send an enquiry</a>
  </section>
</Base>

<style>
  /* Top section: continues the charcoal header */
  .hero { background: var(--charcoal); color: var(--on-dark); }
  .hero__inner {
    display: grid; gap: var(--s4); align-items: center;
    padding-block: var(--s4) var(--s5);
  }
  .hero h1 { max-width: 16ch; margin: 0; }
  .hero__line { margin: var(--s2) 0 var(--s3); color: var(--on-dark-muted); font-size: var(--step-1); max-width: 30rem; }
  .hero .actions { margin: 0; }
  .hero .button:focus-visible { outline-color: var(--on-dark); }
  .hero__photo { background: #67676a; color: var(--on-dark-muted); aspect-ratio: 16 / 9; }
  .hero__photo span { display: grid; justify-items: center; gap: var(--s1); }
  @media (min-width: 48rem) {
    .hero__inner { grid-template-columns: 1.15fr 1fr; padding-block: var(--s5) var(--s6); }
    .hero__photo { aspect-ratio: 4 / 3; }
  }

  /* Credibility strip */
  .strip {
    display: flex; flex-wrap: wrap; justify-content: center; gap: var(--s1) var(--s4);
    margin: 0; max-width: none; padding: var(--s2) var(--gutter); list-style: none;
    background: var(--surface); border-bottom: 1px solid var(--line);
    font-family: var(--font-brand); font-weight: 600; font-size: var(--label);
  }
  .strip li, .strip a { display: flex; align-items: center; gap: var(--s1); color: var(--ink); text-decoration: none; }
  .strip a:hover span { text-decoration: underline; }
  .strip :global(.icon) { color: var(--copper-deep); flex: none; }
  /* Google asks for its logo at the same size as any logo beside it */
  .badge { height: 1.75rem; width: auto; flex: none; }

  .section-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: var(--s1) var(--s2); margin-bottom: var(--s2); }
  .section-head h2 { margin: 0; }
  .section-head a { display: inline-flex; align-items: center; gap: 0.25rem; font-family: var(--font-brand); font-weight: 600; font-size: var(--small); text-decoration: none; }
  .section-head a:hover { text-decoration: underline; }

  /* Service tiles: each is one tap target */
  .tiles { display: grid; gap: var(--s2); grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr)); list-style: none; padding: 0; margin: 0; max-width: none; }
  .tile { position: relative; display: flex; align-items: center; gap: var(--s2); padding: var(--s2) 1.25rem; }
  .tile:hover { border-color: var(--line-strong); }
  .tile__icon { display: grid; place-items: center; width: 3rem; height: 3rem; flex: none; border-radius: 50%; background: var(--bg); color: var(--copper-deep); }
  .tile a { display: block; color: var(--ink); text-decoration: none; font-family: var(--font-brand); font-weight: 700; line-height: 1.3; }
  .tile a::after { content: ''; position: absolute; inset: 0; }
  .tile:hover a { text-decoration: underline; }
  .tile__keywords { display: block; color: var(--muted); font-size: var(--small); }

  .reviews { display: grid; gap: var(--s2); grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr)); }

  .contact-band {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--s2) var(--s3);
    padding: var(--s3); background: var(--charcoal); color: var(--on-dark); border-radius: var(--radius);
  }
  .contact-band h2 { margin: 0 0 0.25rem; }
  .contact-band p { margin: 0; color: var(--on-dark-muted); }
  .contact-band a:not(.button) { color: var(--on-dark); }
  .contact-band a:focus-visible { outline-color: var(--on-dark); }
</style>
